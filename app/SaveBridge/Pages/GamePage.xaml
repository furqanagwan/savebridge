<Page x:Class="SaveBridge.Pages.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:SaveBridge.Models">
  <ScrollViewer>
    <StackPanel Padding="32,16,32,32" Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">
      <StackPanel Spacing="4">
        <TextBlock x:Name="GameTitle" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <FontIcon x:Name="StatusIcon" FontSize="14" />
          <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>
        <TextBlock x:Name="Note" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>

      <InfoBar x:Name="Result" IsClosable="True" />
      <InfoBar x:Name="Achievements" Severity="Informational" IsClosable="False" />

      <!-- accounts -->
      <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ComboBox x:Name="SteamAccount" Header="Steam account" HorizontalAlignment="Stretch"
                  SelectionChanged="Account_Changed" PlaceholderText="Signed-in account" />
        <ComboBox x:Name="XboxAccount" Grid.Column="1" Header="Xbox profile" HorizontalAlignment="Stretch"
                  SelectionChanged="Account_Changed" PlaceholderText="The profile that played the game" />
      </Grid>

      <!-- saves -->
      <InfoBar x:Name="ReadinessXbox" IsClosable="False" />
      <InfoBar x:Name="ReadinessSteam" IsClosable="False" />

      <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" RowSpacing="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Save" Style="{StaticResource BodyStrongTextBlockStyle}" />
          <TextBlock Grid.Column="1" Text="Steam" Style="{StaticResource BodyStrongTextBlockStyle}" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Xbox" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <ProgressRing x:Name="Busy" Width="16" Height="16" />
          </StackPanel>
        </Grid>
        <ListView x:Name="Saves" Grid.Row="1" SelectionMode="Multiple" MaxHeight="420">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="m:SaveRow">
              <Grid ColumnSpacing="12" Padding="0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="148" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Key}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{x:Bind Steam}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="2" Text="{x:Bind Xbox}" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="SavesHint" Grid.Row="2" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Tick saves to copy only those; with none ticked, the game's usual set is copied." />
      </Grid>

      <!-- actions -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="ToXbox" Style="{StaticResource AccentButtonStyle}" Click="ToXbox_Click">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE72A;" FontSize="14" /><TextBlock Text="Copy Steam → Xbox" />
          </StackPanel>
        </Button>
        <Button x:Name="ToSteam" Click="ToSteam_Click">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE72B;" FontSize="14" /><TextBlock Text="Copy Xbox → Steam" />
          </StackPanel>
        </Button>
        <DropDownButton x:Name="ImportSave">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE896;" FontSize="14" /><TextBlock Text="Import a save" />
          </StackPanel>
          <DropDownButton.Flyout>
            <MenuFlyout Placement="Bottom">
              <MenuFlyoutItem x:Name="ImportXboxFolder" Text="Folder into Xbox…" Tag="xbox|folder" Click="Import_Click" />
              <MenuFlyoutItem x:Name="ImportXboxFile" Text="Zip or file into Xbox…" Tag="xbox|file" Click="Import_Click" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem x:Name="ImportSteamFolder" Text="Folder into Steam…" Tag="steam|folder" Click="Import_Click" />
              <MenuFlyoutItem x:Name="ImportSteamFile" Text="Zip or file into Steam…" Tag="steam|file" Click="Import_Click" />
            </MenuFlyout>
          </DropDownButton.Flyout>
        </DropDownButton>
        <DropDownButton x:Name="InspectSave" Content="Inspect save…">
          <DropDownButton.Flyout>
            <MenuFlyout>
              <MenuFlyoutItem Text="Folder…" Tag="folder" Click="Inspect_Click" />
              <MenuFlyoutItem Text="Zip or file…" Tag="file" Click="Inspect_Click" />
            </MenuFlyout>
          </DropDownButton.Flyout>
        </DropDownButton>
        <Button Click="Refresh_Click" ToolTipService.ToolTip="Refresh">
          <FontIcon Glyph="&#xE72C;" FontSize="14" />
        </Button>
      </StackPanel>

      <Expander Header="Options" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="12">
          <CheckBox x:Name="IncludeAll" Content="Also copy optional saves (settings, profile)" />
          <TextBox x:Name="SlotMap" Header="Move slots while copying" PlaceholderText="e.g. 0:1 puts save 0 into slot 1"
                   MaxWidth="420" HorizontalAlignment="Left" />
          <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     Text="Every write is previewed first, backed up to %LOCALAPPDATA%\savebridge\backups and verified afterwards. Close the game before writing." />
        </StackPanel>
      </Expander>

      <Expander Header="Details" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <TextBlock x:Name="Log" FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
      </Expander>
    </StackPanel>
  </ScrollViewer>
</Page>
