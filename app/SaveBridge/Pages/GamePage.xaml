<Page x:Class="SaveBridge.Pages.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:SaveBridge.Models"
      xmlns:s="using:SaveBridge.Services">
  <ScrollViewer x:Name="Scroller" XYFocusKeyboardNavigation="Enabled">
    <StackPanel Padding="0,0,0,40">

      <!-- Hero -->
      <Grid Height="320">
        <ParallaxView Source="{x:Bind Scroller}" VerticalShift="100">
          <Image x:Name="HeroImage" Stretch="UniformToFill" VerticalAlignment="Center" />
        </ParallaxView>
        <Rectangle>
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#00000000" Offset="0.35" />
              <GradientStop Color="#CC000000" Offset="1" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <StackPanel VerticalAlignment="Bottom" Padding="40,0,40,28" Spacing="10">
          <Image x:Name="Logo" MaxHeight="120" MaxWidth="420" HorizontalAlignment="Left" Stretch="Uniform" />
          <TextBlock x:Name="GameTitle" Style="{StaticResource TitleLargeTextBlockStyle}" Foreground="White" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border x:Name="StatusChip" CornerRadius="4" Padding="8,3">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon x:Name="StatusIcon" FontSize="13" Foreground="White" />
                <TextBlock x:Name="StatusText" Foreground="White" FontSize="13" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <TextBlock x:Name="Credits" Foreground="#DDFFFFFF" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <StackPanel Padding="40,16,40,0" Spacing="16" MaxWidth="1280" HorizontalAlignment="Stretch">
        <BreadcrumbBar x:Name="Crumbs" ItemClicked="Crumbs_ItemClicked" />
        <TextBlock x:Name="Description" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <InfoBar x:Name="Note" Severity="Warning" IsClosable="False" />
        <InfoBar x:Name="Result" IsClosable="True" />

        <SelectorBar x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
          <SelectorBarItem Text="Saves" Tag="saves" IsSelected="True">
            <SelectorBarItem.Icon><FontIcon Glyph="&#xE8F1;" /></SelectorBarItem.Icon>
          </SelectorBarItem>
          <SelectorBarItem Text="Save locations" Tag="locations">
            <SelectorBarItem.Icon><FontIcon Glyph="&#xE8B7;" /></SelectorBarItem.Icon>
          </SelectorBarItem>
          <SelectorBarItem Text="Achievements" Tag="achievements">
            <SelectorBarItem.Icon><FontIcon Glyph="&#xE734;" /></SelectorBarItem.Icon>
          </SelectorBarItem>
          <SelectorBarItem Text="Backups" Tag="backups">
            <SelectorBarItem.Icon><FontIcon Glyph="&#xE81C;" /></SelectorBarItem.Icon>
          </SelectorBarItem>
        </SelectorBar>

        <!-- ===== Saves ===== -->
        <StackPanel x:Name="SavesPanel" Spacing="16">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="SteamAccount" Header="Steam account" HorizontalAlignment="Stretch"
                      SelectionChanged="Account_Changed" PlaceholderText="Signed-in account" />
            <ComboBox x:Name="XboxAccount" Grid.Column="1" Header="Xbox profile" HorizontalAlignment="Stretch"
                      SelectionChanged="Account_Changed" PlaceholderText="The profile that played the game" />
          </Grid>

          <InfoBar x:Name="ReadinessXbox" IsClosable="False" />
          <InfoBar x:Name="ReadinessSteam" IsClosable="False" />

          <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" RowSpacing="8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12" Padding="40,0,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Save" Style="{StaticResource BodyStrongTextBlockStyle}" />
              <TextBlock Grid.Column="1" Text="Steam" Style="{StaticResource BodyStrongTextBlockStyle}" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Xbox" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ProgressRing x:Name="Busy" Width="16" Height="16" />
              </StackPanel>
            </Grid>
            <ListView x:Name="Saves" Grid.Row="1" SelectionMode="Multiple" MaxHeight="440" TabFocusNavigation="Once">
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:SaveRow">
                  <Grid ColumnSpacing="12" Padding="0,8" AutomationProperties.Name="{x:Bind Key}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="208" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Key}" FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Steam}" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Xbox}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="SavesHint" Grid.Row="2" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </Grid>

          <CommandBar x:Name="Actions" DefaultLabelPosition="Right" HorizontalAlignment="Left" IsDynamicOverflowEnabled="False">
            <AppBarButton x:Name="ToXbox" Label="Copy Steam → Xbox" Click="ToXbox_Click">
              <AppBarButton.Icon><FontIcon Glyph="&#xE72A;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="ToSteam" Label="Copy Xbox → Steam" Click="ToSteam_Click">
              <AppBarButton.Icon><FontIcon Glyph="&#xE72B;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton x:Name="ImportSave" Label="Import a save">
              <AppBarButton.Icon><FontIcon Glyph="&#xE896;" /></AppBarButton.Icon>
              <AppBarButton.Flyout>
                <MenuFlyout Placement="Bottom">
                  <MenuFlyoutItem x:Name="ImportXboxFolder" Text="Folder into Xbox…" Tag="xbox|folder" Click="Import_Click" />
                  <MenuFlyoutItem x:Name="ImportXboxFile" Text="Zip or file into Xbox…" Tag="xbox|file" Click="Import_Click" />
                  <MenuFlyoutSeparator />
                  <MenuFlyoutItem x:Name="ImportSteamFolder" Text="Folder into Steam…" Tag="steam|folder" Click="Import_Click" />
                  <MenuFlyoutItem x:Name="ImportSteamFile" Text="Zip or file into Steam…" Tag="steam|file" Click="Import_Click" />
                </MenuFlyout>
              </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton x:Name="InspectSave" Label="Inspect a save">
              <AppBarButton.Icon><FontIcon Glyph="&#xE721;" /></AppBarButton.Icon>
              <AppBarButton.Flyout>
                <MenuFlyout Placement="Bottom">
                  <MenuFlyoutItem Text="Folder…" Tag="folder" Click="Inspect_Click" />
                  <MenuFlyoutItem Text="Zip or file…" Tag="file" Click="Inspect_Click" />
                </MenuFlyout>
              </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton Label="Refresh" Click="Refresh_Click">
              <AppBarButton.Icon><FontIcon Glyph="&#xE72C;" /></AppBarButton.Icon>
            </AppBarButton>
          </CommandBar>

          <Expander Header="Options" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="16">
              <ToggleSwitch x:Name="IncludeAll" Header="Also copy optional saves (settings, profile)" />
              <TextBox x:Name="SlotMap" Header="Move slots while copying" PlaceholderText="e.g. 0:1 puts save 0 into slot 1"
                       MaxWidth="420" HorizontalAlignment="Left" />
              <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         Text="Every write is previewed first, backed up and verified afterwards. Close the game before writing." />
            </StackPanel>
          </Expander>
          <Expander Header="Details" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <TextBlock x:Name="Log" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
          </Expander>
        </StackPanel>

        <!-- ===== Save locations ===== -->
        <Grid x:Name="LocationsPanel" Visibility="Collapsed" ColumnSpacing="16" RowSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel x:Name="SteamCard" Spacing="12" Padding="20" CornerRadius="8"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Background="#171A21" CornerRadius="4" Padding="8,3">
                <TextBlock Text="STEAM" Foreground="White" FontWeight="SemiBold" FontSize="13" />
              </Border>
              <TextBlock x:Name="SteamInstall" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="Game folder" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SteamDir" IsTextSelectionEnabled="True" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button x:Name="SteamDirOpen" Grid.Column="1" Click="OpenFolder_Click" ToolTipService.ToolTip="Open in File Explorer"
                        AutomationProperties.Name="Open Steam game folder">
                  <FontIcon Glyph="&#xE838;" FontSize="14" />
                </Button>
              </Grid>
            </StackPanel>
            <TextBlock Text="Saves" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <ItemsControl x:Name="SteamSaves" IsTabStop="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="m:LocateSave">
                  <Grid Margin="0,0,0,12" ColumnSpacing="8" RowSpacing="2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind Who}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Row="1" Text="{x:Bind Summary}" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Grid.Row="2" Text="{x:Bind Path}" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                               FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Grid.Column="1" Grid.RowSpan="3" Tag="{x:Bind Path}" Click="OpenFolder_Click" VerticalAlignment="Center"
                            ToolTipService.ToolTip="Open in File Explorer" AutomationProperties.Name="Open save folder">
                      <FontIcon Glyph="&#xE838;" FontSize="14" />
                    </Button>
                    <Button Grid.Column="2" Grid.RowSpan="3" Tag="{x:Bind Path}" Click="CopyPath_Click" VerticalAlignment="Center"
                            ToolTipService.ToolTip="Copy path" AutomationProperties.Name="Copy save folder path">
                      <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="SteamNote" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>

          <StackPanel x:Name="XboxCard" Grid.Column="1" Spacing="12" Padding="20" CornerRadius="8"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Background="#107C10" CornerRadius="4" Padding="8,3">
                <TextBlock Text="XBOX" Foreground="White" FontWeight="SemiBold" FontSize="13" />
              </Border>
              <TextBlock x:Name="XboxInstall" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="Game folder" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="XboxDir" IsTextSelectionEnabled="True" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button x:Name="XboxDirOpen" Grid.Column="1" Click="OpenFolder_Click" ToolTipService.ToolTip="Open in File Explorer"
                        AutomationProperties.Name="Open Xbox game folder">
                  <FontIcon Glyph="&#xE838;" FontSize="14" />
                </Button>
              </Grid>
            </StackPanel>
            <TextBlock Text="Saves" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <ItemsControl x:Name="XboxSaves" IsTabStop="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="m:LocateSave">
                  <StackPanel Margin="0,0,0,12" Spacing="4">
                    <Grid ColumnSpacing="8" RowSpacing="2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <TextBlock Text="{x:Bind Who}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                      <TextBlock Grid.Row="1" Text="{x:Bind Summary}" Style="{StaticResource CaptionTextBlockStyle}" />
                      <TextBlock Grid.Row="2" Text="{x:Bind Path}" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                      <Button Grid.Column="1" Grid.RowSpan="3" Tag="{x:Bind Path}" Click="OpenFolder_Click" VerticalAlignment="Center"
                              ToolTipService.ToolTip="Open in File Explorer" AutomationProperties.Name="Open save folder">
                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                      </Button>
                      <Button Grid.Column="2" Grid.RowSpan="3" Tag="{x:Bind Path}" Click="CopyPath_Click" VerticalAlignment="Center"
                              ToolTipService.ToolTip="Copy path" AutomationProperties.Name="Copy save folder path">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                      </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind Extra}" IsTabStop="False" Margin="16,0,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:LocateExtra">
                          <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True">
                            <Run Text="+ " /><Run Text="{x:Bind Kind}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{x:Bind Path}" />
                          </TextBlock>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="XboxNote" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Grid>

        <!-- ===== Achievements ===== -->
        <StackPanel x:Name="AchievementsPanel" Visibility="Collapsed" Spacing="12">
          <StackPanel x:Name="AchievementsSignedOut" Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock TextWrapping="Wrap"
                       Text="Sign in to Xbox to see your achievements for this game, and which ones a converted save can still unlock." />
            <Button Content="Sign in to Xbox" Style="{StaticResource AccentButtonStyle}" Click="SignIn_Click" />
          </StackPanel>
          <StackPanel x:Name="AchievementsSignedIn" Spacing="12" Visibility="Collapsed">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ProgressRing x:Name="AchievementRing" IsIndeterminate="False" Width="64" Height="64" Maximum="100" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="AchievementTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="AchievementKinds" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </Grid>
            <ListView x:Name="AchievementList" SelectionMode="None" MaxHeight="640" TabFocusNavigation="Once">
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="s:Achievement">
                  <Grid ColumnSpacing="12" Padding="0,8" Opacity="{x:Bind Opacity}" AutomationProperties.Name="{x:Bind Name}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="56" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Width="56" Height="56" Stretch="UniformToFill">
                      <Image.Source><BitmapImage UriSource="{x:Bind IconUri}" DecodePixelWidth="112" /></Image.Source>
                    </Image>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                      <TextBlock Text="{x:Bind Text}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                      <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="{x:Bind State}" /><Run Text=" · " /><Run Text="{x:Bind Kind}" />
                      </TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind GamerscoreText}" VerticalAlignment="Center"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </StackPanel>
          <InfoBar Severity="Informational" IsOpen="True" IsClosable="False"
                   Message="Title-managed achievements are awarded by the game itself, and many games re-check them when a save loads. Event-based achievements are counted by Xbox Live from play, so a save can't carry them. savebridge never changes achievements." />
        </StackPanel>

        <!-- ===== Backups ===== -->
        <StackPanel x:Name="BackupsPanel" Visibility="Collapsed" Spacing="8">
          <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     Text="A backup is made before every write. Restoring backs up the current saves first, so it can be undone too." />
          <TextBlock x:Name="NoBackups" Text="No backups for this game yet." Visibility="Collapsed" />
          <ItemsControl x:Name="BackupList" IsTabStop="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="m:BackupInfo">
                <Grid Padding="16,12" Margin="0,4" ColumnSpacing="16" CornerRadius="8"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                      <Run Text="{x:Bind Where}" /><Run Text=" saves · " /><Run Text="{x:Bind When}" />
                    </TextBlock>
                    <TextBlock Text="{x:Bind SizeText}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Restore" Tag="{x:Bind}" Click="Restore_Click" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
