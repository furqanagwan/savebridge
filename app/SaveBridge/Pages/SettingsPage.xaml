<Page x:Class="SaveBridge.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Page.Resources>
    <Style x:Key="Card" TargetType="Grid">
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="20,16" />
      <Setter Property="ColumnSpacing" Value="16" />
    </Style>
  </Page.Resources>
  <ScrollViewer XYFocusKeyboardNavigation="Enabled">
    <StackPanel Padding="40,24,40,40" Spacing="8" MaxWidth="1000" HorizontalAlignment="Left">
      <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />

      <TextBlock Text="Appearance" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,4" />
      <Grid Style="{StaticResource Card}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE790;" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="App theme" />
          <TextBlock Text="Follow Windows, or always light or dark" Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <RadioButtons x:Name="Theme" Grid.Column="2" MaxColumns="3" SelectionChanged="Theme_SelectionChanged">
          <x:String>System</x:String>
          <x:String>Light</x:String>
          <x:String>Dark</x:String>
        </RadioButtons>
      </Grid>

      <TextBlock Text="Controller" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
      <Grid Style="{StaticResource Card}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE7FC;" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Show controller button hints" />
          <TextBlock x:Name="PadStatus" Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <ToggleSwitch x:Name="Hints" Grid.Column="2" Toggled="Hints_Toggled" OnContent="On" OffContent="Off" />
      </Grid>
      <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="Controller buttons">
        <TextBlock TextWrapping="Wrap" LineHeight="26">
          <Run FontWeight="SemiBold">D-pad / left stick</Run><Run>  move between items</Run><LineBreak />
          <Run FontWeight="SemiBold">A</Run><Run>  select · </Run><Run FontWeight="SemiBold">B</Run><Run>  back, or close a dialog</Run><LineBreak />
          <Run FontWeight="SemiBold">LB / RB</Run><Run>  previous / next section · </Run><Run FontWeight="SemiBold">LT / RT</Run><Run>  page up / down in lists</Run><LineBreak />
          <Run FontWeight="SemiBold">Y</Run><Run>  refresh · </Run><Run FontWeight="SemiBold">View</Run><Run>  search · </Run><Run FontWeight="SemiBold">Menu</Run><Run>  settings</Run><LineBreak />
          <Run FontWeight="SemiBold">Right stick</Run><Run>  scroll the page</Run>
        </TextBlock>
      </Expander>

      <TextBlock Text="Game info" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
      <Grid Style="{StaticResource Card}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE91B;" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Covers, artwork and descriptions" />
          <TextBlock Text="From Steam's public store data; kept for a week, works offline from the copy on this PC."
                     Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Content="Refresh now" Click="RefreshMeta_Click" />
          <Button Content="Clear" Click="ClearMeta_Click" />
        </StackPanel>
      </Grid>

      <TextBlock Text="Storage" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
      <Grid Style="{StaticResource Card}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE81C;" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Backups and app data" />
          <TextBlock x:Name="DataFolder" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                     IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Button Grid.Column="2" Content="Open folder" Click="OpenData_Click" />
      </Grid>
      <Grid Style="{StaticResource Card}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE756;" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Converter" />
          <TextBlock x:Name="Converter" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                     IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </Grid>
      <InfoBar x:Name="Result" IsClosable="True" Margin="0,8,0,0" />
    </StackPanel>
  </ScrollViewer>
</Page>
